---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { collectTags, getArticleUrl, getPublishedArticles } from "@/lib/articles";
import { formatDate } from "@/lib/date";
import { SITE } from "@/lib/site";

const articles = await getPublishedArticles();
const tags = collectTags(articles);
---

<BaseLayout title={SITE.name} description={SITE.description} canonicalPath="/">
  <section class="hero">
    <p class="eyebrow">Personal blog at {SITE.name}</p>
    <h1>envblex</h1>
    <p class="intro">I am envblex</p>
    <p><a href="/feed.xml">Subscribe via RSS</a></p>
  </section>

  <section class="profile-grid" aria-label="Profile">
    <div>
      <h2>About</h2>
      <p>
        I am a developer, and recently I've been interested in nodejs/go/rust.
        My interests are as follows:
      </p>
      <ul class="interest-list">
        <li><strong>nodejs:</strong> An easy way to create websites</li>
        <li><strong>go:</strong> An easy way to create CLIs</li>
        <li>
          <strong>rust:</strong> An easy way to create fast and secure code
          (I'm still learning, so I don't know the details)
        </li>
      </ul>
      <p>
        I have a strong interest in domains and know about minor TLDs like skin,
        which is used on this website.
      </p>
    </div>

    <div>
      <h2>Contact</h2>
      <ul class="contact-list">
        <li><a href="mailto:envblex@env.skin">envblex@env.skin</a></li>
        <li><a href="mailto:envblex@proton.me">envblex@proton.me</a></li>
        <li><a href="https://github.com/envblex">GitHub: envblex</a></li>
        <li><a href="https://www.youtube.com/@envblex">YouTube: envblex</a></li>
        <li><a href="https://x.com/envblex">X: envblex</a></li>
      </ul>
    </div>
  </section>

  <section aria-labelledby="latest-heading">
    <h2 id="latest-heading">Latest Articles</h2>
    {
      articles.length > 0 ? (
        <ul class="article-list">
          {articles.map((article) => (
            <li class="article-card">
              <article>
                <p class="meta">{formatDate(article.data.publishedAt)}</p>
                <h3>
                  <a href={getArticleUrl(article.slug)}>{article.data.title}</a>
                </h3>
                <p>{article.data.description}</p>
                {article.data.tags.length > 0 && (
                  <ul class="tags" aria-label={`Tags for ${article.data.title}`}>
                    {article.data.tags.map((tag) => (
                      <li class="tag">{tag}</li>
                    ))}
                  </ul>
                )}
              </article>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty-state">No published articles yet.</p>
      )
    }
  </section>

  {
    tags.length > 0 && (
      <section aria-labelledby="tags-heading">
        <h2 id="tags-heading">Tags</h2>
        <ul class="tags">
          {tags.map((tag) => (
            <li class="tag">{tag}</li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
